{
  "description": "v0.1.96 (MANIFEST \u00a712 M-PR-3 to M-PR-6, \u00a74 M-RT-10): socket route cases. `set` replaces top-level members of examples/notes.manifest.json (its service `search` is the declared service); `serviceEnvAdd` / `appEnvAdd` append env entries to service `search` / to runtime.env. `schemaValid` = the result of manifest.schema.json. `rule` + `code` = the refusal the manifest validator (@opt2-tealbrick/manifest) gives; absent = the manifest is accepted. A case with `schemaValid: true` and a rule is refused by the validator only.",
  "cases": [
    {
      "name": "minimal socket route",
      "set": {
        "publicRoutes": [
          {
            "path": "/",
            "purpose": "socket",
            "service": "search"
          }
        ],
        "requires": {
          "bridgeCaps": [
            "socket_origin"
          ]
        }
      },
      "schemaValid": true
    },
    {
      "name": "full socket route beside a webhook, template in a service env",
      "set": {
        "publicRoutes": [
          {
            "path": "/inbound/email",
            "purpose": "webhook"
          },
          {
            "path": "/",
            "purpose": "socket",
            "service": "search",
            "http": true,
            "maxConnections": 2000,
            "idleSeconds": 60,
            "maxBodyMiB": 128
          }
        ],
        "requires": {
          "bridge": "0.1.40",
          "bridgeCaps": [
            "socket_origin"
          ]
        }
      },
      "serviceEnvAdd": [
        {
          "name": "RELAY_URL",
          "value": "{{bridge.socketUrl}}"
        },
        {
          "name": "RELAY_HOST",
          "value": "{{bridge.socketHost}}"
        }
      ],
      "schemaValid": true
    },
    {
      "name": "http false and no maxBodyMiB",
      "set": {
        "publicRoutes": [
          {
            "path": "/",
            "purpose": "socket",
            "service": "search",
            "http": false,
            "maxConnections": 1,
            "idleSeconds": 3600
          }
        ],
        "requires": {
          "bridgeCaps": [
            "socket_origin"
          ]
        }
      },
      "schemaValid": true
    },
    {
