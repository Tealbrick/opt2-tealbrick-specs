{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.opt2.tealbrick.com/instance-slice.schema.json",
  "title": "Instance slice payload (tb-slice+jws)",
  "description": "v0.1. JWS payload of the per-instance slice: signed by Portal (or the standalone issuer), carried inside the workspace config, relayed to the app by the bridge via POST /tb/v1/status (BRIDGE.md §10.4). v0.1.11 (C62/C63): `portalKeySet` (root-signed key-set statement; apps verify slices against it, CREDENTIALS §9.5), `portalKeys` informational.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "ws",
    "rev",
    "ins",
    "product",
    "portalKeys",
    "bridge",
    "pause",
    "revoked",
    "personNbf",
    "grants",
    "agents"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "anyOf": [
        {
          "const": "tb:portal"
        },
        {
          "$ref": "workspace-config.schema.json#/$defs/brgAudience"
        }
      ]
    },
    "sub": {
      "$ref": "workspace-config.schema.json#/$defs/insAudience"
    },
    "aud": {
      "$ref": "workspace-config.schema.json#/$defs/insAudience"
    },
    "iat": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds"
    },
    "exp": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds",
      "description": "iat + 12 h."
    },
    "jti": {
      "$ref": "workspace-config.schema.json#/$defs/ulid"
    },
    "ws": {
      "$ref": "workspace-config.schema.json#/$defs/wsId"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per instance."
    },
    "ins": {
      "$ref": "workspace-config.schema.json#/$defs/insId"
    },
    "product": {
      "$ref": "workspace-config.schema.json#/$defs/productId"
    },
    "portalKeys": {
      "$ref": "workspace-config.schema.json#/$defs/portalKeys"
    },
    "portalKeySet": {
      "$ref": "workspace-config.schema.json#/$defs/portalKeySet"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "keys"
      ],
      "properties": {
        "id": {
          "$ref": "workspace-config.schema.json#/$defs/brgId"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "Keys the app accepts for call proofs (TB-Call).",
          "items": {
            "$ref": "workspace-config.schema.json#/$defs/ed25519Jwk"
          }
        },
        "caps": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "description": "v0.1.54 (C292): capabilities the workspace bridge declared (BRIDGE_CAPS), normalised by Core from its last authenticated status report; absent or [] = none. Advisory: never widens access." },
        "viewUrl": {
          "oneOf": [{ "$ref": "workspace-config.schema.json#/$defs/httpsUrl" }, { "type": "null" }],
          "description": "v0.1.43 (LA-1, C232): the origin of the workspace views service (tb-views) or null when none exists yet; apps answer view_origin_missing (409) while null."
        },
        "publicUrl": {
          "$ref": "workspace-config.schema.json#/$defs/httpsUrl",
          "description": "v0.1.10 (C64): the bridge's public origin; apps build third-party callback URLs `<publicUrl>/p/<product><path>` from it (SDK OpContext.publicUrl). Core MUST emit it once the bridge's public URL is known."
        }
      }
    },
    "pause": {
      "$ref": "workspace-config.schema.json#/$defs/pause"
    },
    "revoked": {
      "$ref": "workspace-config.schema.json#/$defs/revoked"
    },
    "personNbf": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds",
      "description": "App UI sessions created before this time are invalid."
    },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "description": "Companion grants (K10) this instance presents as TB-Grant for manifest-declared app-to-app calls.",
      "items": {
        "$ref": "workspace-config.schema.json#/$defs/compactJws"
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 500,
      "description": "Agents with an edge to this app, or all agents when the manifest sets needsAgentDirectory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mode",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "workspace-config.schema.json#/$defs/agtId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mode": {
            "$ref": "workspace-config.schema.json#/$defs/agentMode"
          },
          "status": {
            "enum": [
              "active",
              "paused"
            ]
          },
          "scopeRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product", "kind"],
            "description": "v0.1.18 (C106a): the channel the owner chose at adopt for an edge with scopeType channel.",
            "properties": {
              "product": { "$ref": "workspace-config.schema.json#/$defs/productId" },
              "kind": { "enum": ["buzz_channel", "connect_inbox"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "createName": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
          }
        }
      }
    },
    "standalone": {
      "$ref": "workspace-config.schema.json#/$defs/standaloneBlock"
    },
    "companionTargets": {
      "type": "array",
      "maxItems": 256,
      "description": "v0.1.14 (C90): the targets this app holds a companion grant for (one per grant).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "ins"],
        "properties": {
          "product": { "$ref": "workspace-config.schema.json#/$defs/productId" },
          "ins": { "$ref": "workspace-config.schema.json#/$defs/insId" }
        }
      }
    },
    "companionCallers": {
      "type": "array",
      "maxItems": 256,
      "description": "v0.1.14 (C102): the instances holding companion grants that target this instance; name = caller manifest name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "ins", "name"],
        "properties": {
          "product": { "$ref": "workspace-config.schema.json#/$defs/productId" },
          "ins": { "$ref": "workspace-config.schema.json#/$defs/insId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "provider": { "oneOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }, { "type": "null" }], "description": "v0.1.48 (C240): where the calling instance runs (railway, own_infra, ...); null = unknown." }
        }
      }
    },
    "appsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held"],
      "description": "v0.1.15 (C105a): the workspace apps policy; companion grants carry held = this list.",
      "properties": {
        "held": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["first_contact", "profile_change", "live_call", "destructive", "money", "outward", "identity", "public_link"] } }
      }
    },
    "appCallers": {
      "enum": ["verified"],
      "description": "v0.1.49 (C261): \"verified\" = every companion grant to this instance carries prd; the SDK refuses an app caller without a verified product (403 caller_unverified). Absent = the earlier lenient rule."
    },
    "portalUrl": {
      "$ref": "workspace-config.schema.json#/$defs/httpsUrl",
      "description": "v0.1.13 (C86): the Portal GUI origin (no path); apps build owner links `<portalUrl>/w/<ws>/open?product=<p>&path=<path>`."
    }
  }
}
