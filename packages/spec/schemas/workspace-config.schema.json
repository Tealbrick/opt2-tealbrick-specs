{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.opt2.tealbrick.com/workspace-config.schema.json",
  "title": "Workspace config payload (tb-config+jws)",
  "description": "v0.1. JWS payload of the signed workspace config pulled by the bridge (BRIDGE.md §5.5). Signed by Portal (iss tb:portal); in standalone the bridge re-mints from the frozen final config (BRIDGE §11). $defs are shared with instance-slice.schema.json. v0.1.11 (C62/C63, BSD-07): `portalKeySet` (root-signed key-set statement; the ONLY trust source, CREDENTIALS §9.5), `portalKeys` informational, `apps[].internalUrl` private-network forms + `ownInfra`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "ws",
    "rev",
    "workspace",
    "bridge",
    "portalKeys",
    "pause",
    "revoked",
    "connections",
    "instanceKeys",
    "grants",
    "apps",
    "agents",
    "hooks",
    "skills",
    "keyRequirements",
    "enrolCodes"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "anyOf": [
        {
          "const": "tb:portal"
        },
        {
          "$ref": "#/$defs/brgAudience"
        }
      ]
    },
    "sub": {
      "$ref": "#/$defs/brgAudience"
    },
    "aud": {
      "$ref": "#/$defs/brgAudience"
    },
    "iat": {
      "$ref": "#/$defs/epochSeconds"
    },
    "exp": {
      "$ref": "#/$defs/epochSeconds",
      "description": "iat + 12 h (43200 s). Past exp the bridge fails closed for agent and app-to-app calls (C9)."
    },
    "jti": {
      "$ref": "#/$defs/ulid"
    },
    "ws": {
      "$ref": "#/$defs/wsId"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision (CREDENTIALS K9 claim)."
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/wsId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publicUrl"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/brgId"
        },
        "publicUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "portalKeys": {
      "$ref": "#/$defs/portalKeys"
    },
    "portalKeySet": {
      "$ref": "#/$defs/portalKeySet"
    },
    "pause": {
      "$ref": "#/$defs/pause"
    },
    "revoked": {
      "$ref": "#/$defs/revoked"
    },
    "connections": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/connectionEntry"
      }
    },
    "instanceKeys": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/instanceKeyEntry"
      }
    },
    "grants": {
      "type": "array",
      "maxItems": 10000,
      "description": "Agent-to-app grants (K10 compact JWS). Companion grants travel inside instance slices.",
      "items": {
        "$ref": "#/$defs/compactJws"
      }
    },
    "apps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/appEntry"
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/agentEntry"
      }
    },
    "hooks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/hookEntry"
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "files"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "files": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product",
              "id",
              "title",
              "content"
            ],
            "properties": {
              "product": {
                "$ref": "#/$defs/productId"
              },
              "id": {
                "type": "string",
                "pattern": "^(?!tb-)[a-z][a-z0-9-]{1,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "when": {
                "type": "string",
                "maxLength": 200,
                "description": "Human-readable usage hint for the instructions index."
              },
              "content": {
                "type": "string",
                "maxLength": 65536,
                "description": "SKILL.md rendered by Core; {{agent.name}} and {{agent.id}} are left for the bridge."
              }
            }
          }
        }
      }
    },
    "keyRequirements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/keyRequirement"
      }
    },
    "modelRoleRequirements": {
      "description": "v0.1.63 (C330(4)): manifest settings.modelRoles[] per instance, `when` resolved by Core (BRIDGE §15). Absent = none.",
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/modelRoleRequirement"
      }
    },
    "enrolCodes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/enrolCodeEntry"
      }
    },
    "standalone": {
      "$ref": "#/$defs/standaloneBlock"
    },
    "workflowGrantsWithdrawn": {
      "type": "array",
      "maxItems": 4096,
      "description": "v0.1.82 (C373, P1; CREDENTIALS §5.1, BRIDGE §8.6): withdrawn per-workflow grants, at most WORKFLOW_WITHDRAWN_MAX (64) per caller instance (64 instances x 64). Sent only to a bridge that declares app_workflow_grants. A grant with wfl is refused when sub and wfl match, aud is absent or matches, and iat <= at.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sub",
          "wfl",
          "at"
        ],
        "properties": {
          "sub": {
            "$ref": "#/$defs/insAudience"
          },
          "wfl": {
            "$ref": "#/$defs/workflowId"
          },
          "aud": {
            "$ref": "#/$defs/insAudience"
          },
          "at": {
            "$ref": "#/$defs/epochSeconds"
          }
        }
      }
    },
    "wflEpoch": {
      "type": "object",
      "maxProperties": 64,
      "description": "v0.1.82 (C373, P1): per caller instance ref, every grant with wfl of that caller with iat <= the value is withdrawn. Sent only to a bridge that declares app_workflow_grants.",
      "propertyNames": {
        "$ref": "#/$defs/insAudience"
      },
      "additionalProperties": {
        "$ref": "#/$defs/epochSeconds"
      }
    }
  },
  "$defs": {
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "v0.1.82 (C373, P1): WORKFLOW_ID_PATTERN, the wfl claim (workflow id of the caller app)."
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "wsId": {
      "type": "string",
      "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agtId": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "conId": {
      "type": "string",
      "pattern": "^con_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "insId": {
      "type": "string",
      "pattern": "^ins_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "brgId": {
      "type": "string",
      "pattern": "^brg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edgId": {
      "type": "string",
      "pattern": "^edg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "brgAudience": {
      "type": "string",
      "pattern": "^tb:brg:brg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "insAudience": {
      "type": "string",
      "pattern": "^tb:ins:ins_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "snakeId": {
      "type": "string",
      "pattern": "^(?!tb_)[a-z][a-z0-9_]{1,39}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^(?!tb-)[a-z][a-z0-9-]{1,31}$"
    },
    "keyName": {
      "type": "string",
      "pattern": "^(?!TB_|RAILWAY_)[A-Z][A-Z0-9_]{1,63}$",
      "description": "Same as manifest envName."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "epochSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "compactJws": {
      "type": "string",
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s/?#@]+(/[^\\s?#]*)?$"
    },
    "internalUrl": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^http://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9-]+)*\\.railway\\.internal:[0-9]{1,5}$",
      "description": "v0.1.11 (BSD-07): private-network origin of a deployed app instance: `http://<name>.railway.internal:<port>` (no path). Own-infrastructure instances use `ownInfraUrl` with `ownInfra: true` (BRIDGE §5.7)."
    },
    "ownInfraUrl": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https?://[^\\s/?#@]+$",
      "description": "v0.1.11 (BSD-07): origin of an own-infrastructure instance (`ownInfra: true`). The bridge routes to it ONLY when the origin is listed in its local env TB_OWN_INFRA_ORIGINS (set by the owner, never by Portal); otherwise it refuses `internal_url_refused` (BRIDGE §5.7)."
    },
    "crudAction": {
      "enum": [
        "create",
        "read",
        "update",
        "delete"
      ]
    },
    "effect": {
      "enum": [
        "read",
        "write",
        "outward",
        "destructive",
        "money"
      ]
    },
    "agentMode": {
      "enum": [
        "free",
        "bound"
      ]
    },
    "ed25519Jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "RFC 7638 thumbprint."
        },
        "alg": {
          "const": "EdDSA"
        },
        "use": {
          "const": "sig"
        }
      }
    },
    "appEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ins",
        "product",
        "version",
        "sdkMajor",
        "manifestDigest",
        "internalUrl",
        "entitled",
        "slice"
      ],
      "properties": {
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "product": {
          "$ref": "#/$defs/productId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sdkMajor": {
          "type": "integer",
          "minimum": 0
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "candidateManifestDigest": {
          "$ref": "#/$defs/digest",
          "description": "v0.1.51 (G2b): the TARGET release's manifest digest, only while a health-gated update attempt runs; manifestDigest stays the serving release. Bridges 0.1.33 / 0.2.4 and later accept either (BRIDGE apps table)."
        },
        "candidateVersion": {
          "$ref": "#/$defs/semver",
          "description": "v0.1.51 (G2b): the target release's version, with candidateManifestDigest."
        },
        "internalUrl": {
          "type": "string",
          "description": "v0.1.11 (BSD-07): `$defs/internalUrl` (railway.internal form), or `$defs/ownInfraUrl` when `ownInfra` is true (see allOf)."
        },
        "ownInfra": {
          "type": "boolean",
          "description": "v0.1.11 (BSD-07): the instance runs on the owner's own infrastructure (neighbour, BRIDGE §10.2). Absent = false."
        },
        "entitled": {
          "type": "boolean",
          "description": "Informational (status/display). Enforcement is by absent grants/hooks/tickets; the bridge never decides on it."
        },
        "slice": {
          "$ref": "#/$defs/compactJws"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "ownInfra"
            ],
            "properties": {
              "ownInfra": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "internalUrl": {
                "$ref": "#/$defs/ownInfraUrl"
              }
            }
          },
          "else": {
            "properties": {
              "internalUrl": {
                "$ref": "#/$defs/internalUrl"
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "candidateManifestDigest": [
          "candidateVersion"
        ],
        "candidateVersion": [
          "candidateManifestDigest"
        ]
      }
    },
    "agentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agt",
        "name",
        "mode"
      ],
      "properties": {
        "agt": {
          "$ref": "#/$defs/agtId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "$ref": "#/$defs/agentMode"
        },
        "persona": {
          "description": "v0.1.63 (C320, C312a): the agent card persona (markdown); the bridge gives it to the agent first (BRIDGE §15.6). C353 / QA-SPEC49-23: PERSONA_PATTERN — TAB, LF, the PERSONA_MARKERS characters, or anything not Cc/Cf/Cs/Default_Ignorable/U+2028/U+2029; no two variation selectors in a row. Unicode-mode regex. C356: no variation selector directly after a marker; Arabic number signs U+0600–0605 and U+06DD are markers. Prepended concatenation marks (U+070F, U+0890–0891, U+08E2, U+110BD, U+110CD) are markers too (Coordinator decision after QA-SPEC49 INFO).",
          "type": "string",
          "maxLength": 8000,
          "pattern": "^(?![\\s\\S]*[\\u00AD\\u034F\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890\\u0891\\u08E2\\u{110BD}\\u{110CD}\\u180B-\\u180F\\u200B-\\u200F\\uFE00-\\uFE0F\\u{E0100}-\\u{E01EF}][\\uFE00-\\uFE0F\\u{E0100}-\\u{E01EF}])(?:[\\t\\n]|[\\u00AD\\u034F\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890\\u0891\\u08E2\\u{110BD}\\u{110CD}\\u180B-\\u180F\\u200B-\\u200F\\uFE00-\\uFE0F\\u{E0100}-\\u{E01EF}]|(?![\\p{Cc}\\p{Cf}\\p{Cs}\\p{Default_Ignorable_Code_Point}\\u2028\\u2029])[\\s\\S])*$"
        }
      }
    },
    "connectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "con",
        "agt",
        "method",
        "gen",
        "status"
      ],
      "properties": {
        "con": {
          "$ref": "#/$defs/conId"
        },
        "agt": {
          "$ref": "#/$defs/agtId"
        },
        "method": {
          "enum": [
            "key",
            "pairing"
          ]
        },
        "gen": {
          "type": "integer",
          "minimum": 1,
          "description": "Connection credential generation; K5 with another gen is refused."
        },
        "publicKey": {
          "$ref": "#/$defs/ed25519Jwk",
          "description": "Key method only (K4 verifier)."
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        }
      },
      "if": {
        "properties": {
          "method": {
            "const": "key"
          }
        }
      },
      "then": {
        "required": [
          "publicKey"
        ]
      },
      "else": {
        "not": {
          "required": [
            "publicKey"
          ]
        }
      }
    },
    "hookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ins",
        "product",
        "hookId",
        "phase",
        "order",
        "timeoutMs",
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}\\.[a-z][a-z0-9_]{1,39}$",
          "description": "<product>.<hookId>"
        },
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "product": {
          "$ref": "#/$defs/productId"
        },
        "hookId": {
          "$ref": "#/$defs/snakeId"
        },
        "phase": {
          "enum": [
            "before",
            "context",
            "after"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "products"
          ],
          "properties": {
            "products": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {
                    "const": "*"
                  },
                  {
                    "$ref": "#/$defs/productId"
                  }
                ]
              }
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/snakeId"
              }
            },
            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/effect"
              }
            }
          }
        },
        "enabled": {
          "type": "boolean",
          "description": "v0.1.24 (C117): owner switch; false = skipped; absent = true. Core lists every declared hook of every deployed app."
        }
      }
    },
    "modelRoleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ins",
        "product",
        "required",
        "minPolicy",
        "usedBy"
      ],
      "properties": {
        "role": {
          "enum": [
            "embeddings",
            "rerank",
            "reasoning",
            "utility",
            "dreaming",
            "summarize",
            "vision",
            "transcribe"
          ]
        },
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "product": {
          "$ref": "#/$defs/productId"
        },
        "required": {
          "type": "boolean"
        },
        "minPolicy": {
          "enum": [
            "local",
            "zdr",
            "standard"
          ]
        },
        "usedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          }
        }
      }
    },
    "keyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "ins",
        "product",
        "required",
        "source",
        "usedBy"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/keyName"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "provider": {
          "type": "string",
          "maxLength": 60
        },
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "product": {
          "$ref": "#/$defs/productId"
        },
        "required": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "account_default",
            "app_own"
          ]
        },
        "usedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "const": "app"
              },
              {
                "$ref": "#/$defs/serviceId"
              }
            ]
          }
        }
      }
    },
    "enrolCodeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "kind",
        "exp"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "instance",
            "service",
            "neighbour"
          ]
        },
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "product": {
          "$ref": "#/$defs/productId"
        },
        "service": {
          "$ref": "#/$defs/serviceId"
        },
        "exp": {
          "$ref": "#/$defs/epochSeconds"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service"
              }
            }
          },
          "then": {
            "required": [
              "ins",
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "instance",
                  "neighbour"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ins",
              "product"
            ]
          }
        }
      ]
    },
    "standaloneBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "kid",
        "ownerKeys"
      ],
      "description": "CREDENTIALS §17. Present only in the final Portal-signed config/slices.",
      "properties": {
        "issuer": {
          "$ref": "#/$defs/brgAudience"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Thumbprint of the bridge key (K7) that becomes the issuer."
        },
        "ownerKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/ed25519Jwk"
          }
        }
      }
    },
    "portalKeys": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "description": "CREDENTIALS §5.1. Empty only in the final standalone config. v0.1.11 (C62/C63): INFORMATIONAL — kept (required) for one minor because the frozen v0.1 wire requires it; Core emits it equal to the `keys` of `portalKeySet`; the trust rule ignores it whenever a key-set statement is present or pinned (CREDENTIALS §9.5). Removed in v0.2.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jwk",
          "status"
        ],
        "properties": {
          "jwk": {
            "$ref": "#/$defs/ed25519Jwk"
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "retired"
            ]
          }
        }
      }
    },
    "portalKeySet": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "description": "v0.1.11 (C62/C63): the CURRENT key-set statement, compact JWS `typ: tb-keyset+jws` signed by a Portal Root Key (claims `{iss: tb:portal-root, aud: tb:portal-keys, seq, iat, keys[{jwk, status}]}`, types/credentials.ts KeySetStatementClaims). Verifiers derive the trusted Portal key set ONLY from the newest valid statement (CREDENTIALS §9.5). Optional in v0.1.11 (transition until Core emits it); required in v0.2. C356 / QA-SPEC49-27: ≤ 4,096 chars (a statement of ≤ 8 Ed25519 keys is ≈ 2.4k) so the slice reserve holds."
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "agents",
        "instances"
      ],
      "properties": {
        "workspace": {
          "type": "boolean",
          "description": "Workspace kill switch."
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/agtId"
          }
        },
        "instances": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/insId"
          }
        }
      },
      "description": "Workspace kill switch, agent pause, instance pause. No connections: a connection revoke is enforced only at the bridge (connections[].status)."
    },
    "revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jtis"
      ],
      "properties": {
        "jtis": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jti",
              "exp"
            ],
            "properties": {
              "jti": {
                "$ref": "#/$defs/ulid"
              },
              "exp": {
                "$ref": "#/$defs/epochSeconds"
              }
            }
          }
        }
      }
    },
    "instanceKeyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ins",
        "jwk"
      ],
      "properties": {
        "ins": {
          "$ref": "#/$defs/insId"
        },
        "svc": {
          "$ref": "#/$defs/serviceId"
        },
        "jwk": {
          "$ref": "#/$defs/ed25519Jwk"
        }
      }
    },
    "httpsOrigin": {
      "type": "string",
      "maxLength": 267,
      "pattern": "^https://[^\\s/?#@]+$",
      "description": "C356 / QA-SPEC49-27: an https origin (scheme + host + optional port, no path), ≤ 267 chars. Used for slice URLs so the slice reserve holds at the schema limits."
    }
  }
}
